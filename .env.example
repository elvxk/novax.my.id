# Upstream public DNS, RDAP, IP, License, & Preview services (Server-side only)
DOH_BASE_URL=https://dns.google/resolve
RDAP_BASE_URL=https://rdap.org/domain/
IP_API_URL=https://ipwho.is
VERIFY_CPANEL_URL=https://verify.cpanel.net/app/verify
CLN_URL=https://cln.cloudlinux.com/wapi/check/ip
PREVIEW_SERVICE_URL=https://rover.novax.my.id

# API Rate Limiting (International Standard: 60 req / 60 sec per client IP)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# ACME SSL certificate generator service (Server-side only)
SSL_GENERATOR_API_URL=https://api.pradipta.dev/ssl

# Discord webhook for feedback submissions (Server-side only)
# Get this from Discord Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Remote Chrome/CDP WebSocket endpoint for HTML to PDF (Server-side only)
BROWSER_WS_ENDPOINT=ws://127.0.0.1:3005?token=your-secret-token
