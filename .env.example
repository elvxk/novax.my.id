# Upstream public DNS, RDAP, IP, & License services (Server-side only)
DOH_BASE_URL=https://dns.google/resolve
RDAP_BASE_URL=https://rdap.org/domain/
IP_API_URL=https://ipwho.is
VERIFY_CPANEL_URL=https://verify.cpanel.net/app/verify
CLN_URL=https://cln.cloudlinux.com/wapi/check/ip

# API Rate Limiting (International Standard: 60 req / 60 sec per client IP)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
